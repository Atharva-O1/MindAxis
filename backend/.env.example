# Copy to .env and adjust if needed.
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_BASE_URL=http://localhost:11434

# postgresql+psycopg://<role>:<password>@localhost:5432/<database>
DATABASE_URL=postgresql+psycopg://mindaxis:changeme@localhost:5432/mindaxis
# Generate your own, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme

# Real OTP Email Sending via SMTP (e.g. Gmail App Password, Resend, SendGrid)
# If omitted, OTPs will print to server console.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=MindAxis Support <your.email@gmail.com>

